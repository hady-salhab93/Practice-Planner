{
  "name": "@practice-planner/core",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --maxWorkers=1",
    "lint": "oxlint --type-aware src"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.44.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "7.0.2",
    "vitest": "^3.0.0"
  }
}
